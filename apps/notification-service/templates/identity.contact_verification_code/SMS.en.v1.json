{
  "variables": {
    "code": {
      "type": "code",
      "required": true,
      "secret": true,
      "maxLength": 12
    },
    "expiresAt": {
      "type": "datetime",
      "required": true
    }
  },
  "bodyText": "Your verification code is {{code}}. It expires at {{expiresAt}}. Never share it.",
  "smsMaxSegments": 2
}
