# auth-service configuration. Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit real values.
# Every secret below has no default: the service refuses to start without it.
# In deployed environments provide secrets from your secret manager (KMS/Vault/K8s Secret) as env
# vars or, preferably, as mounted files via the NAME_FILE convention (e.g. JWT_SECRET_FILE=/run/secrets/jwt).
#
# Generate each secret independently (they must all differ):
#   openssl rand -base64 32

NODE_ENV=development
DATABASE_URL=postgres://auth:CHANGE_ME@localhost:5432/auth

# --- secrets (base64 of >= 32 random bytes each) ---
JWT_SECRET=
OPERATOR_CODE_PEPPER=
SECRET_KEY_PEPPER=
THROTTLE_KEY_PEPPER=
JOIN_CODE_PEPPER=          # HMAC key for organization join codes
# AES-256-GCM keys sealing owner TOTP secrets: "id:base64(32 bytes)". Several ids may coexist while
# rotating (add the new key, switch ACTIVE to it, re-encrypt, then remove the old one).
TOTP_ENCRYPTION_KEYS=
TOTP_ENCRYPTION_ACTIVE_KEY_ID=

# --- WebAuthn (required in production; origins must be https) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000
WEBAUTHN_RP_NAME=Nawara

# --- payment-service boundary (registration-time license check only, ADR-0026) ---
PAYMENT_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_TOKEN=

# --- Swagger UI (basic auth, served at /auth/docs; NOT mounted at all unless a password is set) ---
# SWAGGER_USERNAME=docs
# SWAGGER_PASSWORD=          # >= 16 chars, e.g. openssl rand -hex 24

# --- onboarding ---
# REQUIRE_CONTACT_VERIFICATION=false   # true only once a channel delivers verification codes (none exists yet)
# CONTACT_CODE_TTL_SEC=900
# Admin invitation lifetime (minutes). The admin picks a duration inside [MIN, MAX]; the server computes expiresAt.
# INVITATION_MIN_MINUTES=15
# INVITATION_DEFAULT_MINUTES=1440   # 24 hours
# INVITATION_MAX_MINUTES=10080      # 7 days

# --- optional tuning (defaults shown in src/config/app-config.ts) ---
# TRUST_PROXY=true            # only behind a proxy you control; enables X-Forwarded-For for client IP
# CORS_ORIGINS=https://admin.example.com   # exact http(s) origins, comma-separated; "*", paths or bare hosts stop startup
# WORK_TIMEZONE=Africa/Tunis  # timezone OperatorSchedule HH:mm values are interpreted in
# RECOVERY_COOLDOWN_SEC=86400
# RATE_OPERATOR_VERIFY_IDENTIFIER_LIMIT=10
