# organization-service configuration. Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit real values.
# organization-service is IMPLEMENTED BUT NOT YET AUTHORITATIVE: auth-service still owns Company/Platform/Organization until the
# ownership migration of ADR-0039 is performed (a later stage). See apps/organization-service/README.md.

NODE_ENV=development
# Least-privilege runtime role (organization_app), never the migrator or a superuser (refused in production). See infra/postgres.
DATABASE_URL=postgres://organization_app:dev_organization_app_pw@localhost:5433/organization

# --- service-to-service callers (ADR-0033); <caller>:<sha256 digest>[,<caller>:<digest>], at most two per caller.
# --- Generate a token and its digest with generateServiceToken() from @nawara/service-kit; store only the digest here.
# --- Empty (the default) means EVERY call is refused. There is no Auth URL and no user-token path: a user's bearer is never accepted.
# SERVICE_TOKENS=

# --- service authorization policy (ADR-0042). REQUIRED once any caller is registered: a registered caller with no entry refuses to start.
# --- capabilities: hierarchy.reference.read (ids and parents only), hierarchy.read (full read), hierarchy.provision (create a Company; a
# --- dedicated identity ALONE, outside Platform scope). hierarchy.write cannot be assigned. allowedPlatforms is an EXPLICIT list of platform ids
# --- (possibly empty): there is no wildcard and no implicit all-Platform access. A client never supplies it.
# SERVICE_POLICY={"callers":{"payment-service":{"capabilities":["hierarchy.reference.read"],"allowedPlatforms":["<platform-uuid>"]},"provisioning":{"capabilities":["hierarchy.provision"]}}}

# --- ownership operations (ADR-0040): the OPERATIONS login (schema owner / migrator), NEVER the runtime role. Read only by `npm run ownership`.
# --- Authority is never activated by starting, deploying or migrating the service; only `npm run ownership -- activate` moves it, and in
# --- production it additionally needs OWNERSHIP_PRODUCTION_ACTIVATION=enabled for that run, after the gates G1 to G7 of ADR-0040.
# OWNERSHIP_ADMIN_DATABASE_URL=

# --- Swagger UI (basic auth, served at /organization/docs; NOT mounted at all unless a password of 16+ characters is set) ---
# SWAGGER_USERNAME=docs
# SWAGGER_PASSWORD=          # e.g. openssl rand -hex 24. May be supplied as SWAGGER_PASSWORD_FILE=/run/secrets/...

# --- optional tuning (defaults shown in libs/service-kit/src/config/base-config.ts) ---
# PORT=3000
# LOG_LEVEL=info
# BODY_LIMIT_KB=100
# CORS_ORIGINS=https://admin.example.com   # exact http(s) origins, comma-separated; unset means CORS is off
# TRUST_PROXY=true                          # only behind a proxy you control
