# payment-service configuration. Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit real values.
# See docs/sdd/payment-service.md section 16 for the full list and meaning of these settings.

NODE_ENV=development
# Least-privilege runtime role (payment_app), never the migrator/superuser role. See infra/postgres.
DATABASE_URL=postgres://payment_app:dev_payment_app_pw@localhost:5433/payment

# --- Auth (live identity/membership lookups; the service fails closed if Auth cannot answer) ---
AUTH_SERVICE_URL=http://localhost:3001
# AUTH_TIMEOUT_MS=3000

# --- service-to-service callers (SDD section 8.1); <caller>:<sha256 digest>[,<caller>:<digest>] ---
# SERVICE_TOKENS=

# --- events (unset RABBITMQ_URL uses the in-memory bus: fine for local/dev; REFUSED at startup when NODE_ENV=production) ---
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- payment domain configuration (no business meaning; see the SDD for the open decisions, O-10/O-16/O-19) ---
# PAYMENT_SUPPORTED_CURRENCIES=TND
# PAYMENT_MAX_ATTEMPTS=3
# IDEMPOTENCY_TTL_HOURS=24
# Baseline abuse limits: requests per minute per authenticated producer (create) / payer (attempts). See SDD section 16.
# PAYMENT_RATE_LIMIT_CREATE_PER_MINUTE=300
# PAYMENT_RATE_LIMIT_ATTEMPT_PER_MINUTE=30
# PAYMENT_RETURN_URL_ALLOWLIST=
# Only for local/dev/test: the service refuses to start with this set when NODE_ENV=production.
# PAYMENT_TEST_PROVIDER=true

# --- Swagger UI (basic auth, served at /payment/docs; NOT mounted at all unless a password is set) ---
# SWAGGER_USERNAME=docs
# SWAGGER_PASSWORD=          # >= 16 chars, e.g. openssl rand -hex 24

# --- optional tuning (defaults shown in src/config/payment-config.ts) ---
# PORT=3000
# LOG_LEVEL=info
# BODY_LIMIT_KB=100
# CORS_ORIGINS=https://admin.example.com   # exact http(s) origins, comma-separated
# TRUST_PROXY=true                          # only behind a proxy you control
