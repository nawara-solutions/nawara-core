# billing-service configuration. Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit real values.
# See docs/sdd/billing-service.md (section 34.1, Stage 1) for what this foundation does and does not include.

NODE_ENV=development
# Least-privilege runtime role (billing_app), never the migrator or a superuser (refused in production). See infra/postgres.
DATABASE_URL=postgres://billing_app:dev_billing_app_pw@localhost:5433/billing

# --- Auth (live identity and membership for user bearers; the service fails closed if Auth cannot answer) ---
AUTH_SERVICE_URL=http://localhost:3001
# AUTH_TIMEOUT_MS=3000

# --- service-to-service callers (SDD section 20); <caller>:<sha256 digest>[,<caller>:<digest>], at most two per caller.
# --- Generate a token and its digest with generateServiceToken() from @nawara/service-kit; store only the digest here.
# SERVICE_TOKENS=

# --- events: unset RABBITMQ_URL uses the in-memory bus, which is REFUSED in production ---
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- currencies this deployment accepts (REQUIRED, no default: which currencies are supported is a business decision, B-005) ---
BILLING_SUPPORTED_CURRENCIES=TND

# --- Swagger UI (basic auth, served at /billing/docs; NOT mounted at all unless a password of 16+ characters is set) ---
# SWAGGER_USERNAME=docs
# SWAGGER_PASSWORD=          # e.g. openssl rand -hex 24. May be supplied as SWAGGER_PASSWORD_FILE=/run/secrets/...

# --- optional tuning (defaults shown in libs/service-kit/src/config/base-config.ts) ---
# PORT=3000
# LOG_LEVEL=info
# BODY_LIMIT_KB=100
# CORS_ORIGINS=https://admin.example.com   # exact http(s) origins, comma-separated; unset means CORS is off
# TRUST_PROXY=true                          # only behind a proxy you control
