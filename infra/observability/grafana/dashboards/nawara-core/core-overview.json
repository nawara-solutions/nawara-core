      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nawara-prometheus"
          },
          "refId": "A",
          "expr": "(sum by (job) (rate(nawara_http_server_requests_total{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\",status_class=\"5xx\"}[5m])) or (0 * sum by (job) (rate(nawara_http_server_requests_total{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\"}[5m])))) / (sum by (job) (rate(nawara_http_server_requests_total{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\"}[5m])) >= (1/60))",
          "legendFormat": "{{job}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "no data",
          "custom": {
