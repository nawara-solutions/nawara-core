    {
      "type": "stat",
      "id": 9,
      "title": "Last readiness result",
      "description": "`nawara_readiness_ready` from the LAST /ready run: 1 ready, 0 not ready (including draining). It is set only when something calls /ready; the Compose healthchecks call /health. Before the first run the kit exports 0 with a last-run timestamp of 0, so a service is listed only once its last-run timestamp is set: an unlisted service (or \"not run\") means /ready has not run, NOT that it is unready. Absent or stale is not evidence that a service is unhealthy. There is no readiness alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "nawara-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nawara-prometheus"
          },
          "refId": "A",
          "expr": "nawara_readiness_ready{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\"} and on (job, instance) (nawara_readiness_last_run_timestamp_seconds{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\"} > 0)",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "not run",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT READY",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "READY",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "id": 10,
      "title": "Age of last readiness run",
      "description": "`time() - nawara_readiness_last_run_timestamp_seconds`, for runs that happened (timestamp > 0): how old the result to the left is. Large: the result is old, not wrong. A service whose /ready never ran is not listed; \"not run\" when none has.",
      "datasource": {
        "type": "prometheus",
        "uid": "nawara-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nawara-prometheus"
          },
          "refId": "A",
          "expr": "time() - (nawara_readiness_last_run_timestamp_seconds{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\"} > 0)",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
