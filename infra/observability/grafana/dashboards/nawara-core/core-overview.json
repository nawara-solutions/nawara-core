    {
      "type": "timeseries",
      "id": 13,
      "title": "5xx ratio by job (≥ 1 request/min)",
      "description": "Share of 5xx answers over 5 minutes. Computed only when the job served at least 1 request per minute in that window; below that it is left blank (not applicable), never shown as 0. 0 means traffic with no 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "nawara-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
