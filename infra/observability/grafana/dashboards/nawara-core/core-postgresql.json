{
  "uid": "nawara-core-postgresql",
  "title": "Core · PostgreSQL",
  "description": "V2 A12.6.2: the shared local PostgreSQL server and one database in detail (choose it with \"Database\"), through postgres-exporter. LOCAL observability. Provisioned from the repository; edits in the UI are not saved.",
  "tags": [
    "nawara-core",
    "local"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 41,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "datname",
        "label": "Database",
        "description": "A Core service database, or the postgres maintenance database (exporter and admin sessions). Template databases are excluded.",
        "datasource": {
          "type": "prometheus",
          "uid": "nawara-prometheus"
        },
        "definition": "label_values(pg_database_size_bytes{job=\"postgres\",datname=~\"auth|billing|payment|accounting|organization|notification|file|audit|release|postgres\"}, datname)",
        "query": "label_values(pg_database_size_bytes{job=\"postgres\",datname=~\"auth|billing|payment|accounting|organization|notification|file|audit|release|postgres\"}, datname)",
