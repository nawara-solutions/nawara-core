    {
      "type": "timeseries",
      "id": 6,
      "title": "Consumed by outcome",
      "description": "`sum by (outcome) (rate(nawara_events_consumed_total[5m]))` for the selected queue. processed = the handler completed (a later acknowledgement failure is counted separately as a settle failure). An outcome appears once it first happened (not yet observed before). No data: nothing consumed since start.",
      "datasource": {
        "type": "prometheus",
        "uid": "nawara-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nawara-prometheus"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(nawara_events_consumed_total{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\",queue=\"$queue\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "none observed",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Handler duration p95 / p99 (histogram estimate)",
      "description": "`nawara_event_handler_duration_seconds` for the selected queue, 5-minute window (buckets 5 ms … 60 s; precise only to the bucket bounds). Blank when nothing was handled in the window.",
      "datasource": {
        "type": "prometheus",
        "uid": "nawara-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 10,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nawara-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nawara_event_handler_duration_seconds_bucket{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\",queue=\"$queue\"}[5m]))) and on () (sum(rate(nawara_event_handler_duration_seconds_count{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\",queue=\"$queue\"}[5m])) > 0)",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nawara-prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(nawara_event_handler_duration_seconds_bucket{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\",queue=\"$queue\"}[5m]))) and on () (sum(rate(nawara_event_handler_duration_seconds_count{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\",queue=\"$queue\"}[5m])) > 0)",
          "legendFormat": "p99",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "no deliveries in window",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
