      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nawara-prometheus"
          },
          "refId": "A",
          "expr": "sum by (job, queue) (nawara_events_consumed_total{job=~\"auth-service|billing-service|payment-service|organization-service|notification-service|file-service|audit-service|release-service\",outcome=\"dead_letter_deferred\"})",
          "legendFormat": "{{job}} · {{queue}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "none observed",
          "mappings": [],
