{
  "name": "@nawara/service-kit",
  "version": "0.1.0",
  "description": "Technical foundations shared by Nawara Core services: configuration, logging, request context, errors, health, service authentication, database, migrations, outbox/inbox events. No business logic.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "bin": {
    "nawara-migrate": "./dist/cli/migrate.js",
    "nawara-check-dlq": "./dist/cli/check-dlq-depth.js",
    "nawara-dlq": "./dist/cli/dlq.js",
    "nawara-check-outbox-lag": "./dist/cli/check-outbox-lag.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:integration": "vitest run --config ./vitest.config.integration.ts"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
