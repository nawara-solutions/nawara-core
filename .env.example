# Local development only. Copy to .env (gitignored) and change nothing unless you need to. NOT production credentials:
# production secrets are generated on the server and never stored in Git (see docs/architecture/production-readiness.md).
# Passwords may contain only letters, digits, underscore, dot and dash (the init script refuses anything else).
POSTGRES_ADMIN_PASSWORD=dev_admin_pw
AUTH_MIGRATOR_PASSWORD=dev_auth_migrator_pw
AUTH_APP_PASSWORD=dev_auth_app_pw
BILLING_MIGRATOR_PASSWORD=dev_billing_migrator_pw
BILLING_APP_PASSWORD=dev_billing_app_pw
PAYMENT_MIGRATOR_PASSWORD=dev_payment_migrator_pw
PAYMENT_APP_PASSWORD=dev_payment_app_pw
ACCOUNTING_MIGRATOR_PASSWORD=dev_accounting_migrator_pw
ACCOUNTING_APP_PASSWORD=dev_accounting_app_pw
ORGANIZATION_MIGRATOR_PASSWORD=dev_organization_migrator_pw
ORGANIZATION_APP_PASSWORD=dev_organization_app_pw
NOTIFICATION_MIGRATOR_PASSWORD=dev_notification_migrator_pw
NOTIFICATION_APP_PASSWORD=dev_notification_app_pw
# notification-service secret key ring (Stage 16.5, AES-256-GCM, id:base64(32 bytes)). A throwaway dev-only key, never used anywhere real.
NOTIFICATION_SECRET_KEYS=dev1:W2jz6n+X1XxDsz40Rd9FNjbXektj/L2tzy3tqPp5Tqc=
# notification-service API request-hash key (Stage 16.6, HMAC-SHA-256, base64 of >= 32 random bytes). Throwaway, dev-only.
NOTIFICATION_REQUEST_HASH_KEY=jnWMF97hE8+LffU69R1IDfwyRaoHB3Xxavj26JNE9b4=
# notification-service providers (Stage 16.8). Compose defaults both channels to `test` (no network). To try the real APIs locally,
# set resend / twilio and supply YOUR OWN credentials here (never commit them); see apps/notification-service/README.md.
# NOTIFICATION_EMAIL_PROVIDER=resend
# NOTIFICATION_RESEND_API_KEY=
# NOTIFICATION_EMAIL_FROM=Nawara <no-reply@your-verified-domain.example>
# NOTIFICATION_SMS_PROVIDER=twilio
# NOTIFICATION_TWILIO_ACCOUNT_SID=
# NOTIFICATION_TWILIO_API_KEY_SID=
# NOTIFICATION_TWILIO_API_KEY_SECRET=
# NOTIFICATION_TWILIO_MESSAGING_SERVICE_SID=

# --- auth-service (Stage 5 Compose wiring): every value below is a throwaway dev-only secret,
# generated the same way (`openssl rand -base64 32` / random bytes), never reused anywhere real.
AUTH_JWT_SECRET=565DxgmWnTbMTCEm16mGipSaQM1lbFtm+eJW6lpY5VQ=
AUTH_OPERATOR_CODE_PEPPER=DrAa5yv7G4h2q1qimz89aB1g2G4Ce0fX5EZXHh3G2Ps=
AUTH_SECRET_KEY_PEPPER=NmmKva8gySFwZ5NMw5YRhQTrNoY8tUuUhDmdx+B3xgg=
AUTH_THROTTLE_KEY_PEPPER=xn6BzJIj1uNFgnSKVmpfRMraB63QMxfSzOypUFxHMDE=
AUTH_JOIN_CODE_PEPPER=7XEcPD79UtVUxrIQUm/N3X1OEAdwUV+sdajQAjgQKY4=
AUTH_TOTP_KEY_K1=TebUmg364umnKL5JWPZ2rxa4bFV6z1RCpFE368DwdHU=

